# Digital Bank Backend Environment Configuration
# Copy this file to .env and update the values

# ============================================
# Database Configuration
# ============================================
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ============================================
# Service Configuration
# ============================================
SERVICE_PORT=8080
DB_PORT=5432
PROFILE=prod

# ============================================
# Security Configuration
# ============================================
# IMPORTANT: Change this to a strong random string in production!
# Generate one with: openssl rand -base64 32
JWT_SECRET_KEY=your-string-jwt-secret-key-here-change-in-production

# ============================================
# Spring Boot Configuration
# ============================================
SPRING_PROFILES_ACTIVE=prod

# ============================================
# Frontend Configuration
# ============================================
FRONTEND_PORT=3000
API_BASE_URL=http://localhost:8080

# ============================================
# Optional: Production Optimizations
# ============================================
# Uncomment and adjust for production deployment

# JVM Memory Settings
# JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# Database Connection Pool
# SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
# SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5
# SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000

# Logging
# LOGGING_LEVEL_ROOT=INFO
# LOGGING_LEVEL_COM_DIGITALBANK=DEBUG

# ============================================
# Optional: External Services
# ============================================
# Add configuration for external services like Redis, Kafka, etc.

# Redis (for caching)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Kafka (for messaging)
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
